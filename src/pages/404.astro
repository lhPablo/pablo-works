---
import Layout from "../layouts/Layout.astro";
import { getTranslations, DEFAULT_LANGUAGE } from "../lib/i18n";

const translations = getTranslations(Astro.currentLocale);
---

<Layout showHeader={false}>
  <main
    class="w-full h-screen flex flex-col items-center justify-center gap-4 p-4 text-center"
  >
    <p class="font-mono text-6xl font-semibold text-accent">404</p>
    <h1>{translations.notFound}</h1>
    <a
      href={`/${DEFAULT_LANGUAGE}/`}
      class="btn-primary rounded-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:ring-offset-2 focus-visible:ring-offset-background"
    >
      {translations.goHome}
    </a>
  </main>
</Layout>
