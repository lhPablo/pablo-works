---
import "../styles/global.css";

import { Font } from "astro:assets";

import Header from "../components/Header.astro";
import { DEFAULT_LANGUAGE,LANGUAGES } from "../lib/i18n";

interface Props {
  showHeader?: boolean;
  noindex?: boolean;
}

const { showHeader = true, noindex = false } = Astro.props;

const localeHref = (lang: string) =>
  new URL(Astro.url.pathname.replace(/^\/[^\/]+/, `/${lang}`), Astro.site).href;
---

<!doctype html>
<html lang={Astro.currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link
            rel="canonical"
            href={new URL(Astro.url.pathname, Astro.site).href}
          />
          {LANGUAGES.map((lang) => (
            <link rel="alternate" hreflang={lang} href={localeHref(lang)} />
          ))}
          <link
            rel="alternate"
            hreflang="x-default"
            href={localeHref(DEFAULT_LANGUAGE)}
          />
        </>
      )
    }
    <title>Pablo López — Software Engineer</title>

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />

    <script is:inline>
      const saved = localStorage.getItem("theme");

      const systemDark = window.matchMedia(
        "(prefers-color-scheme: dark)",
      ).matches;

      const theme = saved || (systemDark ? "dark" : "light");

      document.documentElement.setAttribute("data-theme", theme);
    </script>
  </head>
  <body>
    {showHeader && <Header />}
    <slot />
  </body>
</html>
