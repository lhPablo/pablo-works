---
import type { Language } from "../lib/i18n";
import { LANGUAGES, DEFAULT_LANGUAGE } from "../lib/i18n";
---

<span>
  <select
    id="lang-select"
    name="lang"
    class="border border-gray-300 p-1.5 rounded-md bg-background text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
  >
    {
      LANGUAGES.map((l: Language) => (
        <option value={l} selected={Astro.currentLocale === l}>
          {l}
        </option>
      ))
    }
  </select>
</span>

<script
  is:inline
  define:vars={{ languages: LANGUAGES, defaultLang: DEFAULT_LANGUAGE }}
>
  const select = document.getElementById("lang-select");

  select?.addEventListener("change", (e) => {
    const target = e.target;
    const newLang = target.value;
    const pathSegments = window.location.pathname.split("/").filter(Boolean);

    if (languages.includes(pathSegments[0])) {
      pathSegments.shift();
    }

    let newPath = "/";
    if (newLang !== defaultLang) {
      newPath += newLang + "/";
    }
    if (pathSegments.length > 0) {
      newPath += pathSegments.join("/") + "/";
    }

    window.location.href = newPath;
  });
</script>
