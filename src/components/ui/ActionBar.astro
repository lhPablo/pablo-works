---
import LinkedinIcon from "@components/icons/Linkedin.astro";
import ActionLink from "@components/ui/ActionLink.astro";
import { PROFILE } from "@data/profile";
import { getTranslations } from "@lib/i18n";
import { Mail } from "@lucide/astro";

const translations = getTranslations(Astro.currentLocale);
---

<nav class="flex gap-4 text-xs">
  <ActionLink
    href={PROFILE.cv}
    target="_blank"
    rel="noopener noreferrer"
    id="downloadCV"
    class="border rounded-full p-2 cursor-pointer hover:text-accent focus-ring"
  >
    {translations.downloadCV}
  </ActionLink>
  <ActionLink
    href={PROFILE.linkedin}
    target="_blank"
    rel="noopener noreferrer"
    icon={LinkedinIcon}
    iconClass="h-4 w-4"
    aria-label="Linkedin"
  >
    Linkedin
  </ActionLink>

  <ActionLink
    href={`mailto:${PROFILE.email}`}
    icon={Mail}
    iconClass="h-4 w-4"
    aria-label={translations.contact}
  >
    {translations.contact}
  </ActionLink>
</nav>
