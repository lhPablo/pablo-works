---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div">;

const { class: className, ...attrs } = Astro.props;
---

<div
  class:list={[
    "flex flex-col border-2 border-white/10 bg-white/5 p-4 rounded-xl shadow-lg",
    className,
  ]}
  {...attrs}
>
  <slot />
</div>
