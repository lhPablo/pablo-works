---
import type { HTMLAttributes } from "astro/types";

type IconComponent = (_props: { class?: string }) => any;

interface Props extends HTMLAttributes<"a"> {
  icon?: IconComponent;
  iconClass?: string;
}

const { icon: Icon, iconClass, ...attrs } = Astro.props;
---

<div class="shimmer hover:scale-105 transition-transform duration-200">
  <a
    class="bg-surface border border-border rounded-xl p-2 hover:text-accent transition-colors duration-200 focus-ring"
    {...attrs}
  >
    {
      Icon ? (
        <div class="flex items-center gap-1">
          <Icon class={`${iconClass ?? ""}`.trim()} />
          <slot />
        </div>
      ) : (
        <slot />
      )
    }
  </a>
</div>
