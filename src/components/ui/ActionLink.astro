---
import type { HTMLAttributes } from "astro/types";

type IconComponent = (_props: { class?: string }) => any;

interface Props extends HTMLAttributes<"a"> {
  icon?: IconComponent;
  iconClass?: string;
}

const { icon: Icon, iconClass, ...attrs } = Astro.props;
---

<a
  class="bg-transparent border rounded-xl p-2 hover:text-accent hover:scale-110 transition-all duration-200 focus-ring"
  {...attrs}
>
  {
    Icon ? (
      <div class="flex items-center gap-1">
        <Icon class={`${iconClass ?? ""}`.trim()} />
        <slot />
      </div>
    ) : (
      <slot />
    )
  }
</a>
