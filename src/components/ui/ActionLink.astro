---
import { getTranslations } from "@lib/i18n";
import type { HTMLAttributes } from "astro/types";

type IconComponent = (_props: { class?: string }) => any;

interface Props extends HTMLAttributes<"a"> {
  icon?: IconComponent;
  iconClass?: string;
}

const { icon: Icon, iconClass, ...attrs } = Astro.props;

const translations = getTranslations(Astro.currentLocale);
const opensInNewTab = attrs.target === "_blank";
---

<div class="shimmer">
  <a
    class="bg-surface border border-border rounded-xl p-2 hover:text-accent transition-colors duration-200 focus-ring"
    {...attrs}
  >
    {
      Icon ? (
        <div class="flex items-center gap-1">
          <Icon class={`${iconClass ?? ""}`.trim()} />
          <slot />
        </div>
      ) : (
        <slot />
      )
    }
    {opensInNewTab && <span class="sr-only">{translations.opensInNewTab}</span>}
  </a>
</div>
