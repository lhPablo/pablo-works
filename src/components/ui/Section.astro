---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

interface Props {
  id: string;
  component: AstroComponentFactory;
}

const { id, component: Component } = Astro.props;
---

<section
  id={id}
  class="w-full min-h-dvh flex flex-col items-center justify-center lg:max-w-4xl md:max-w-2xl"
>
  <Component />
</section>
