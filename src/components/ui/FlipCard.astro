---
interface Props {
  class?: string;
  faceClass?: string;
}

const { class: className, faceClass } = Astro.props;
---

<div class="group h-full perspective-distant">
  <div
    class:list={[
      "grid h-full transition-transform duration-500 motion-reduce:transition-none transform-3d group-hover:rotate-y-180",
      className,
    ]}
  >
    <div class:list={["[grid-area:1/1] backface-hidden", faceClass]}>
      <slot name="front" />
    </div>

    <div class:list={["[grid-area:1/1] backface-hidden rotate-y-180", faceClass]}>
      <slot name="back" />
    </div>
  </div>
</div>
