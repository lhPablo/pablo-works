---
import frame from "@assets/projects/devices/frame.png";
import laptopMask from "@assets/projects/devices/mask-laptop.png";
import phoneMask from "@assets/projects/devices/mask-phone.png";
import tabletMask from "@assets/projects/devices/mask-tablet.png";
import type { ProjectMockup } from "@data/projects";
import { getTranslations } from "@lib/i18n";
import { Pause, Play } from "@lucide/astro";
import { getImage, Image } from "astro:assets";

interface Props {
  name: string;
  mockup: ProjectMockup;
}

const DEVICE_SCREEN = {
  LAPTOP: "laptop",
  TABLET: "tablet",
  PHONE: "phone",
} as const;

const SCREENS = {
  [DEVICE_SCREEN.LAPTOP]: {
    left: 15.679,
    top: 2.073,
    width: 61.38,
    height: 86.829,
    mask: laptopMask,
  },
  [DEVICE_SCREEN.TABLET]: {
    left: 60.098,
    top: 13.374,
    width: 26.228,
    height: 83.699,
    mask: tabletMask,
  },
  [DEVICE_SCREEN.PHONE]: {
    left: 83.255,
    top: 20.244,
    width: 16.42,
    height: 78.618,
    mask: phoneMask,
  },
};

const screen = (device: keyof typeof SCREENS) => {
  const { left, top, width, height, mask } = SCREENS[device];
  const shape = `url(${mask.src}) center / 100% 100% no-repeat`;
  return `left:${left}%;top:${top}%;width:${width}%;height:${height}%;-webkit-mask:${shape};mask:${shape}`;
};

const { name, mockup } = Astro.props;
const translations = getTranslations(Astro.currentLocale);
const poster = await getImage({
  src: mockup.laptop.poster,
  width: 1360,
  format: "webp",
});
---

<div class="relative" data-device-mockup>
  <video
    class="absolute bg-black object-cover"
    style={screen(DEVICE_SCREEN.LAPTOP)}
    data-poster={poster.src}
    muted
    loop
    playsinline
    preload="none"
    aria-label={`${translations.demoVideo} ${name}`}
  >
    <source src={mockup.laptop.webm} type="video/webm" />
    <source src={mockup.laptop.mp4} type="video/mp4" />
  </video>
  <Image
    src={mockup.tablet}
    alt=""
    widths={[300, 600, 900]}
    sizes="(min-width: 1024px) 285px, (min-width: 768px) 160px, 27vw"
    class="absolute object-cover"
    style={screen(DEVICE_SCREEN.TABLET)}
  />
  <Image
    src={mockup.phone}
    alt=""
    widths={[200, 400, 600]}
    sizes="(min-width: 1024px) 179px, (min-width: 768px) 100px, 17vw"
    class="absolute object-cover"
    style={screen(DEVICE_SCREEN.PHONE)}
  />
  <Image
    src={frame}
    alt={`${translations.previewOf} ${name}`}
    widths={[800, 1200, 1600, 2200]}
    sizes="(min-width: 1024px) 1088px, (min-width: 768px) 608px, calc(100vw - 64px)"
    loading="eager"
    class="pointer-events-none relative h-auto w-full"
  />
  <div
    class="pointer-events-none absolute flex items-end justify-end p-[4%]"
    style={screen(DEVICE_SCREEN.LAPTOP)}
  >
    <button
      type="button"
      class="group pointer-events-auto cursor-pointer rounded-full bg-black/60 p-2 text-white backdrop-blur-sm focus-ring"
      aria-label={`${translations.playDemo}: ${name}`}
      data-toggle
      data-play-label={`${translations.playDemo}: ${name}`}
      data-pause-label={`${translations.pauseDemo}: ${name}`}
    >
      <Play class="h-4 w-4 group-data-playing:hidden" />
      <Pause class="hidden h-4 w-4 group-data-playing:block" />
    </button>
  </div>
</div>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  document
    .querySelectorAll<HTMLElement>("[data-device-mockup]")
    .forEach((container) => {
      const video = container.querySelector("video");
      const toggle =
        container.querySelector<HTMLButtonElement>("[data-toggle]");

      if (!video || !toggle) return;

      // Once the user pauses, scrolling back into view must not restart it
      let userPaused = reducedMotion.matches;

      const sync = () => {
        const playing = !video.paused;
        toggle.toggleAttribute("data-playing", playing);
        toggle.ariaLabel = playing
          ? toggle.dataset.pauseLabel!
          : toggle.dataset.playLabel!;
      };

      video.addEventListener("play", sync);
      video.addEventListener("pause", sync);

      toggle.addEventListener("click", () => {
        userPaused = !video.paused;
        if (userPaused) video.pause();
        else video.play().catch(sync);
      });

      new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) video.pause();
          else if (!userPaused) video.play().catch(sync);
        },
        { threshold: 0.4 },
      ).observe(container);

      // A poster attribute downloads eagerly, so it is only set when the mockup gets near the viewport
      const posterObserver = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          video.poster = video.dataset.poster!;
          posterObserver.disconnect();
        },
        { rootMargin: "100% 0px" },
      );
      posterObserver.observe(container);
    });
</script>
