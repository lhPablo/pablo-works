---
import { EXPERIENCE } from "@data/experience";
import { getTranslations } from "@lib/i18n";

const translations = getTranslations(Astro.currentLocale);
---

<h1>{translations["experience"]}</h1>
<div class="flex flex-col gap-2 items-center justify-start">
  {
    EXPERIENCE.map((exp) => (
      <div class="flex flex-col gap-2 items-center justify-start">
        <p>{exp.company}</p>
        <p>{exp.from}</p>
        <p>{exp.to}</p>
        <p>{exp.role}</p>
        <p>{exp.description}</p>
      </div>
    ))
  }
</div>
