---
import CodeIcon from "@components/icons/Code.astro";
import type { Project } from "@data/projects";
import { getSkill } from "@data/skills";
import { getTranslations } from "@lib/i18n";
import { ExternalLink } from "@lucide/astro";

import ActionLink from "@/components/ui/ActionLink.astro";
import DeviceMockup from "@/components/ui/DeviceMockup.astro";

import TechnologyBadge from "./TechnologyBadge.astro";

interface Props {
  project: Project;
}

const { name, description, url, repo, technologies, mockup } =
  Astro.props.project;

const translations = getTranslations(Astro.currentLocale);
---

<article class="flex flex-col gap-8">
  <div>
    <h4>{name}</h4>
    <DeviceMockup name={name} mockup={mockup} />

    <div class="flex flex-col gap-5">
      <ul class="flex flex-wrap gap-3">
        {
          technologies.map((technologyName) => {
            const skill = getSkill(technologyName);

            return skill ? (
              <li>
                <TechnologyBadge name={skill.name} icon={skill.icon} />
              </li>
            ) : null;
          })
        }
      </ul>
    </div>

    <p>{description}</p>

    <div class="flex text-xs gap-5">
      <ActionLink
        href={repo}
        target="_blank"
        rel="noopener noreferrer"
        icon={CodeIcon}
        iconClass="h-4 w-4"
      >
        {translations.code}
      </ActionLink>
      <ActionLink
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        icon={ExternalLink}
        iconClass="h-4 w-4"
      >
        {translations.visitWebsite}
      </ActionLink>
    </div>
  </div>
</article>
