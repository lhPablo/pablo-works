---
import CodeIcon from "@components/icons/Code.astro";
import type { Project } from "@data/projects";
import { getSkill } from "@data/skills";
import { getTranslations } from "@lib/i18n";
import { ExternalLink } from "@lucide/astro";

import ActionLink from "@/components/ui/ActionLink.astro";
import ImageCarousel from "@/components/ui/ImageCarousel.astro";

import TechnologyBadge from "./TechnologyBadge.astro";

interface Props {
  project: Project;
}

const { name, description, url, repo, technologies, images } =
  Astro.props.project;

const translations = getTranslations(Astro.currentLocale);
---

<article class="grid grid-cols-2 gap-10">
  <div>
    <ImageCarousel name={name} images={images} />
  </div>

  <div class="flex flex-col gap-5">
    <h4>{name}</h4>
    <ul class="flex gap-3">
      {
        technologies.map((technologyName) => {
          const skill = getSkill(technologyName);

          return skill ? (
            <li>
              <TechnologyBadge name={skill.name} icon={skill.icon} />
            </li>
          ) : null;
        })
      }
    </ul>
    <p>{description}</p>

    <div class="flex text-xs gap-5">
      <ActionLink
        href={repo}
        target="_blank"
        rel="noopener noreferrer"
        icon={CodeIcon}
        iconClass="h-4 w-4"
      >
        {translations.code}
      </ActionLink>
      <ActionLink
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        icon={ExternalLink}
        iconClass="h-4 w-4"
      >
        {translations.visitWebsite}
      </ActionLink>
    </div>
  </div>
</article>
