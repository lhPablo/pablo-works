---
import SectionTitle from "@components/ui/SectionTitle.astro";
import { PROJECTS } from "@data/projects";
import { getTranslations } from "@lib/i18n";

import ProjectInfo from "./ProjectInfo.astro";

const translations = getTranslations(Astro.currentLocale);
---

<SectionTitle title={translations.projects} />

<div class="py-8 sm:px-8 flex flex-col gap-5">
  <ul class="flex flex-col items-stretch gap-10">
    {
      PROJECTS.map((project) => (
        <li>
          <ProjectInfo project={project} />
        </li>
      ))
    }
  </ul>
</div>
