---
import LinkedinIcon from "@components/icons/Linkedin.astro";
import ActionLink from "@components/ui/ActionLink.astro";
import { PROFILE } from "@data/profile";
import { yearsOfExperience } from "@lib/experience";
import {
  DEFAULT_LANGUAGE,
  getTranslations,
  type Language,
  splitByPlaceholder,
  type SplitByPlaceholderResult,
} from "@lib/i18n";
import { Mail } from "@lucide/astro";
import { Image } from "astro:assets";

const locale = (Astro.currentLocale ?? DEFAULT_LANGUAGE) as Language;
const translations = getTranslations(locale);
const splitName: SplitByPlaceholderResult = splitByPlaceholder(
  translations.heroGreeting,
  "{{name}}",
);
const splitYears: SplitByPlaceholderResult = splitByPlaceholder(
  translations.heroParagraph,
  "{{yearsOfExperience}}",
);
---

<section
  id="home"
  class="w-full min-h-svh px-4 pt-header flex flex-col-reverse gap-15 items-center justify-center lg:max-w-4xl md:max-w-2xl sm:flex-row"
>
  <div class="flex flex-col gap-5 items-start justify-start">
    <header class="flex flex-col gap-2 items-start justify-start">
      <h1>
        {splitName.before}
        <span class="text-gradient">{PROFILE.name}</span>
        {splitName.after}
      </h1>
      <p class="font-mono text-lg text-muted">{PROFILE.role}</p>
    </header>
    <p>
      {splitYears.before}{yearsOfExperience()}{splitYears.after}
    </p>
    <div class="flex flex-wrap gap-4 text-xs">
      <ActionLink
        href={PROFILE.cv[locale]}
        target="_blank"
        rel="noopener noreferrer"
        id="downloadCV"
      >
        {translations.downloadCV}
      </ActionLink>
      <ActionLink
        href={PROFILE.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        icon={LinkedinIcon}
        iconClass="h-4 w-4"
      >
        Linkedin
      </ActionLink>
      <ActionLink
        href={`mailto:${PROFILE.email}`}
        icon={Mail}
        iconClass="h-4 w-4"
      >
        {translations.contact}
      </ActionLink>
    </div>
  </div>

  <div class="flex shrink-0 w-full max-w-80 sm:w-64 md:w-72 lg:w-80">
    <Image
      src={PROFILE.image}
      alt={translations.profile}
      width={330}
      height={440}
      densities={[1, 2]}
      priority={true}
      class="w-full h-auto rounded-3xl border border-border shadow-xl"
    />
  </div>
</section>
