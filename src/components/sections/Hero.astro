---
import LinkedinIcon from "@components/icons/Linkedin.astro";
import ActionLink from "@components/ui/ActionLink.astro";
import { PROFILE } from "@data/profile";
import { yearsOfExperience } from "@lib/experience";
import {
  getTranslations,
  splitByPlaceholder,
  type SplitByPlaceholderResult,
} from "@lib/i18n";
import { Mail } from "@lucide/astro";
import { Image } from "astro:assets";

const translations = getTranslations(Astro.currentLocale);
const splitName: SplitByPlaceholderResult = splitByPlaceholder(
  translations.heroGreeting,
  "{{name}}",
);
const splitYears: SplitByPlaceholderResult = splitByPlaceholder(
  translations.heroParagraph,
  "{{yearsOfExperience}}",
);
---

<section
  id="home"
  class="w-full min-h-svh px-4 pt-header flex flex-col-reverse gap-15 items-center justify-center lg:max-w-4xl md:max-w-2xl sm:flex-row"
>
  <div class="flex flex-col gap-5 items-start justify-start">
    <header class="flex flex-col gap-2 items-start justify-start">
      <h1>
        {splitName.before}
        <span class="text-gradient">{PROFILE.name}</span>
        {splitName.after}
      </h1>
      <p class="font-mono text-lg text-muted">{PROFILE.role}</p>
    </header>
    <p>
      {splitYears.before}{yearsOfExperience()}{splitYears.after}
    </p>
    <nav class="flex flex-wrap gap-4 text-xs">
      <ActionLink
        href={PROFILE.cv}
        target="_blank"
        rel="noopener noreferrer"
        id="downloadCV"
      >
        {translations.downloadCV}
      </ActionLink>
      <ActionLink
        href={PROFILE.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        icon={LinkedinIcon}
        iconClass="h-4 w-4"
        aria-label="Linkedin"
      >
        Linkedin
      </ActionLink>
      <ActionLink
        href={`mailto:${PROFILE.email}`}
        icon={Mail}
        iconClass="h-4 w-4"
        aria-label={translations.contact}
      >
        {translations.contact}
      </ActionLink>
    </nav>
  </div>

  <div
    class="flex shrink-0 rounded-2xl p-0.5 bg-linear-to-br from-accent-2 via-accent to-accent-3 shadow-[0_0_3rem_-0.75rem_var(--color-accent)]"
  >
    <Image
      src={PROFILE.image}
      alt={translations.profile}
      width={256}
      height={256}
      priority={true}
      class="rounded-[0.875rem] short:size-40"
    />
  </div>
</section>
