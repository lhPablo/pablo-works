---
interface Props {
  company: string;
  from: Date;
  to: Date;
  role: string;
  description: string;
}

const props: Props = Astro.props;
---

<li
  class="historic-item border-2 border-white/10 bg-white/5 p-4 rounded-xl shadow-lg hover:bg-white/10 hover:-translate-y-1 transition-all duration-300"
>
  <h3 class="text-xl font-semibold mb-2">{props.company}</h3>
  <p class="text-sm text-muted">{props.role}</p>
  <p class="text-xs text-muted text-accent">
    {
      props.from.toLocaleDateString(undefined, {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      })
    }
    &nbsp; - &nbsp;
    {
      props.to.toLocaleDateString(undefined, {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      })
    }
  </p>
  <p class="mt-2">{props.description}</p>
</li>
