---
interface Props {
  company: string;
  from: Date;
  to: Date;
  role: string;
  description: string;
}

const { company, from, to, role, description } = Astro.props;
---

<div
  class="card hover:bg-white/10 hover:-translate-y-1 transition-all duration-300"
>
  <h3 class="text-xl font-semibold mb-2">{company}</h3>
  <p class="text-sm text-muted">{role}</p>
  <p class="text-xs text-muted text-accent">
    {
      from.toLocaleDateString(undefined, {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      })
    }
    &nbsp; - &nbsp;
    {
      to.toLocaleDateString(undefined, {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
      })
    }
  </p>
  <p class="mt-2">{description}</p>
</div>
