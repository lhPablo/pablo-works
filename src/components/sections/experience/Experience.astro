---
import JobCard from "@components/sections/experience/JobCard.astro";
import { EXPERIENCE } from "@data/experience";
import { getTranslations } from "@lib/i18n";

const translations = getTranslations(Astro.currentLocale);
---

<h3>{translations["experience"]}</h3>
<ol class="historic-items flex flex-col-reverse gap-5 justify-start py-2 my-5">
  {
    EXPERIENCE.map((exp) => (
      <li class="historic-item">
        <JobCard
          company={exp.company}
          from={exp.from}
          to={exp.to}
          role={exp.role}
          description={translations.jobs[exp.id]}
        />
      </li>
    ))
  }
</ol>
