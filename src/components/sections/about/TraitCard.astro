---
import Card from "@components/ui/Card.astro";
import FlipCard from "@components/ui/FlipCard.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<FlipCard class="min-h-40">
  <Card slot="front" class="h-full items-center justify-center text-center">
    <h4 class="p-5">{title}</h4>
  </Card>
  <Card slot="back" class="h-full items-center justify-center text-center">
    <p class="p-5">{description}</p>
  </Card>
</FlipCard>
