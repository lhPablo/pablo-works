---
import TraitCard from "@components/sections/about/TraitCard.astro";
import { TRAITS } from "@data/traits";
import { getTranslations } from "@lib/i18n";

const translations = getTranslations(Astro.currentLocale);
---

<h3>
  {translations["about"]}
</h3>

<div class="p-8 flex flex-col gap-10">
  <p
    class="text-md text-foreground/80 leading-relaxed"
    set:html={translations["aboutMeParagraph"]}
  />

  <ul class="grid grid-cols-3 gap-5">
    {
      TRAITS.map((trait) => (
        <TraitCard title={trait.title} description={trait.description} />
      ))
    }
  </ul>
</div>
