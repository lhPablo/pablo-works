---
import Skill from "@components/sections/skills/Skill.astro";
import { SKILLS } from "@data/skills";
---

<ul
  class="grid grid-cols-4 sm:grid-cols-6 gap-10 items-center justify-items-center"
>
  {
    SKILLS.map((item) => (
      <li>
        <Skill name={item.name} icon={item.icon} color={item.color} />
      </li>
    ))
  }
</ul>
