---
import Skill from "@components/sections/skills/Skill.astro";
import SectionTitle from "@components/ui/SectionTitle.astro";
import { SKILLS } from "@data/skills";
import { getTranslations } from "@lib/i18n";

const translations = getTranslations(Astro.currentLocale);
---

<SectionTitle
  title={translations.skills}
  description={translations.skillsParagraph}
/>

<ul
  class="grid grid-cols-4 sm:grid-cols-6 gap-4 sm:gap-10 items-center justify-items-center"
>
  {
    SKILLS.map((item) => (
      <li>
        <Skill name={item.name} icon={item.icon} color={item.color} />
      </li>
    ))
  }
</ul>
