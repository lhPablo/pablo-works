---
import { SECTIONS } from "../data/sections";
import { getTranslations } from "../lib/i18n";

const translations = getTranslations(Astro.currentLocale);
---

<div class="w-full flex justify-evenly gap-2">
  {
    SECTIONS.map((section) => {
      return (
        <a
          href={`#${section.id}`}
          data-section={section.id}
          class="rounded-full p-2 hover:text-accent nav-link focus-ring"
        >
          {translations[section.title as keyof typeof translations]}
        </a>
      );
    })
  }
</div>

<script>
  const links: Map<string, HTMLAnchorElement> = new Map(
    [
      ...document.querySelectorAll<HTMLAnchorElement>(
        ".nav-link[data-section]",
      ),
    ].map((link: HTMLAnchorElement) => [link.dataset.section!, link]),
  );

  const sections: NodeListOf<HTMLElement> =
    document.querySelectorAll<HTMLElement>("#main-page > section");

  if (sections.length) {
    const observer: IntersectionObserver = new IntersectionObserver(
      (entries: IntersectionObserverEntry[]) => {
        entries.forEach((entry: IntersectionObserverEntry) => {
          const link: HTMLAnchorElement | undefined = links.get(
            entry.target.id,
          );
          if (!link) return;

          link.classList.toggle("active", entry.isIntersecting);
          if (entry.isIntersecting) {
            link.ariaCurrent = "true";
          } else {
            link.removeAttribute("aria-current");
          }
        });
      },
      { threshold: 0.5 },
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>
