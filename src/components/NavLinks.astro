---
import { SECTIONS } from "../data/sections";
import { getTranslations } from "../lib/i18n";

const translations = getTranslations(Astro.currentLocale);
---

<div class="w-full flex justify-evenly gap-2">
  {
    SECTIONS.map((section) => {
      return (
        <a href={`#${section.id}`}>
          {translations[section.title as keyof typeof translations]}
        </a>
      );
    })
  }
</div>
