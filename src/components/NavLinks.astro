---
import { SECTIONS } from "@data/sections";
import { getTranslations } from "@lib/i18n";

const translations = getTranslations(Astro.currentLocale);
---

<div class="w-full flex justify-evenly gap-2">
  {
    SECTIONS.map((section) => {
      return (
        <a
          href={`#${section.id}`}
          data-section={section.id}
          class="rounded-full p-2 hover:text-accent nav-link focus-ring"
        >
          {translations[section.title as keyof typeof translations]}
        </a>
      );
    })
  }
</div>

<script>
  const links = new Map<string, HTMLAnchorElement>(
    [
      ...document.querySelectorAll<HTMLAnchorElement>(
        ".nav-link[data-section]",
      ),
    ].map((link) => [link.dataset.section!, link]),
  );

  const sections = document.querySelectorAll<HTMLElement>(
    "#main-page > section",
  );

  if (sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const link = links.get(entry.target.id);
          if (!link) return;

          link.classList.toggle("active", entry.isIntersecting);
          if (entry.isIntersecting) {
            link.ariaCurrent = "true";
          } else {
            link.removeAttribute("aria-current");
          }
        });
      },
      { threshold: 0.5 },
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>
