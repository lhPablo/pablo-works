---
import { getTranslations } from "../lib/i18n";
import { Image } from "astro:assets";
import astroLogo from "../assets/astro.svg";
import { SECTIONS } from "../data/sections";

const translations = getTranslations(Astro.currentLocale as any);
---

<nav class="w-full flex justify-start items-center gap-2">
  <a href="#home">
    <Image src={astroLogo} alt="logo" width={100} height={100} />
  </a>

  <div class="w-full flex justify-evenly gap-2">
    {
      SECTIONS.map((section) => {
        return (
          <a href={`#${section.id}`}>
            {translations[section.title as keyof typeof translations]}
          </a>
        );
      })
    }
  </div>
</nav>
