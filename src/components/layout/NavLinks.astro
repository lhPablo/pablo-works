---
import { SECTIONS } from "@data/sections";
import { getTranslations } from "@lib/i18n";

const translations = getTranslations(Astro.currentLocale);
---

<div class="w-full flex flex-col gap-1 sm:flex-row sm:justify-evenly sm:gap-2">
  {
    SECTIONS.map((section) => {
      return (
        <a
          href={`#${section.id}`}
          data-section={section.id}
          class="rounded-full p-2 hover:text-accent aria-[current=true]:text-accent aria-[current=true]:bg-accent/10 focus-ring"
        >
          {translations[section.title as keyof typeof translations]}
        </a>
      );
    })
  }
</div>

<script>
  const links = new Map<string, HTMLAnchorElement>(
    [...document.querySelectorAll<HTMLAnchorElement>("a[data-section]")].map(
      (link) => [link.dataset.section!, link],
    ),
  );

  const sections = document.querySelectorAll<HTMLElement>(
    "#main-page > section",
  );

  if (sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const link = links.get(entry.target.id);
          if (!link) return;

          if (entry.isIntersecting) {
            link.ariaCurrent = "true";
          } else {
            link.removeAttribute("aria-current");
          }
        });
      },
      { rootMargin: "-50% 0px -50% 0px" },
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>
