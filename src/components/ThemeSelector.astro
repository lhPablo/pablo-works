---
import { getTranslations } from "@lib/i18n";
import { Moon, Sun } from "@lucide/astro";

const translations = getTranslations(Astro.currentLocale);
---

<button
  id="themeToggle"
  class="bg-transparent rounded-full hover:text-accent hover:scale-110 transition-all duration-200 focus-ring"
  aria-label={translations.toggleTheme}
>
  <Sun class="h-5 w-5 not-dark:hidden" />
  <Moon class="h-5 w-5 dark:hidden" />
</button>

<script>
  type Theme = "light" | "dark";

  const root: HTMLElement = document.documentElement;
  const btn: HTMLElement | null = document.getElementById("themeToggle");

  if (btn) {
    btn.addEventListener("click", () => {
      const isDark: boolean = root.dataset.theme === "dark";
      const next: Theme = isDark ? "light" : "dark";

      localStorage.setItem("theme", next);
      root.dataset.theme = next;
    });
  } else {
    console.warn("Could not find themeToggle button!");
  }
</script>
