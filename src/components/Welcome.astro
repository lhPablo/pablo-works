---
import { getTranslations } from "../lib/i18n";

const lang = Astro.currentLocale || "es";
const translations = getTranslations(lang as any);
---

<div id="container" class="max-w-4xl mx-auto p-4">
  <main class="py-12 text-center">
    <section id="hero">
      <h1 class="mb-6">{translations.welcome}</h1>
      <button class="btn-primary">Click me</button>
    </section>
  </main>
</div>


